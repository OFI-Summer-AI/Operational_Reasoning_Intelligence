# ─── LLM (Groq) ───────────────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=4096

# ─── Vector Store ─────────────────────────────────────────────────────────────
CHROMADB_PERSIST_DIR=./data/chromadb
CHROMADB_COLLECTION_NAME=ori_incidents

# ─── Embeddings ───────────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_CACHE_DIR=./data/embedding_cache

# ─── Data Paths ───────────────────────────────────────────────────────────────
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
SYNTHETIC_DATA_PATH=./data/synthetic/synthetic_incidents.json

# ─── API ──────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
CORS_ORIGINS=http://localhost:3000,http://localhost:8501

# ─── Giskard ──────────────────────────────────────────────────────────────────
# UI/API: one-row giskard.scan after Groq (GISKARD_LIVE_SCAN). Batch: giskard-scan mode.
GISKARD_SCAN_ENABLED=true
GISKARD_SCAN_MODE=off
GISKARD_LIVE_SCAN=true
GISKARD_USE_FULL_SCAN=true
GISKARD_HF_TOKEN=
INPUT_VALIDATION_CASES_PATH=./testcases/input_validation.json
GISKARD_EVAL_SAMPLE_SIZE=5
GISKARD_EVAL_POOL_SIZE=50
GISKARD_EVAL_SEED=42
GISKARD_REUSE_CACHE=true
GOVERNANCE_CACHE_PATH=./data/governance/rca_predictions.json
GISKARD_EVAL_REPORT_DIR=./reports

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=pretty
LOG_FILE=./logs/ori.log

# ─── Kaggle (optional — datasets/download.py) ─────────────────────────────────
KAGGLE_USERNAME=
KAGGLE_KEY=
